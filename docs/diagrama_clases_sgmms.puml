package "structures (ESTRUCTURAS PROPIAS)" #FFF3CD {
    class BinarySearchTree<T> {
        -root: BSTNode<T>
        -comparator: Comparator<T>
        -size: int
        +insert(value: T): void
        +contains(value: T): boolean
        +search(value: T): T
        +delete(value: T): boolean
        +findMin(): T
        +findMax(): T
        +inOrder(): LinkedList<T>
        +preOrder(): LinkedList<T>
        +postOrder(): LinkedList<T>
        +height(): int
        +size(): int
        +clear(): void
        +getRoot(): BSTNode<T>
    }

    class BSTNode<T> {
        -value: T
        -left: BSTNode<T>
        -right: BSTNode<T>
    }

    class LinkedList<T> {
        -head: Node<T>
        -tail: Node<T>
        -size: int
        +addFirst(value: T): void
        +addLast(value: T): void
        +getFirst(): T
        +removeFirst(): T
        +get(index: int): T
        +remove(index: int): T
        +contains(value: T): boolean
        +sort(comparator: Comparator<T>): void
        +binarySearch(target: T, comparator: Comparator<T>): int
        +size(): int
    }

    class Node<T> {
        -value: T
        -next: Node<T>
    }

    class Stack<T> {
        -elements: LinkedList<T>
        +push(value: T): void
        +pop(): T
        +peek(): T
        +isEmpty(): boolean
        +size(): int
    }

    BinarySearchTree *-- "0..1" BSTNode
    LinkedList *-- "0..*" Node
    Stack *-- "1" LinkedList : elements
}

